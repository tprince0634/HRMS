<%--
  Shared admin sidebar. Include this in every admin JSP:
  <%@ include file="/WEB-INF/views/common/admin-sidebar.jspf" %>
  The current page is detected from request.getRequestURI(), so no page needs
  hard-coded "active" classes.
--%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="sidebar" id="sidebar">
    <div class="sidebar-logo">
        <a href="${pageContext.request.contextPath}/admin/dashboard" class="logo logo-normal">
            <img src="${pageContext.request.contextPath}/assets/img/logo.svg" alt="HRMS Logo">
        </a>
        <a href="${pageContext.request.contextPath}/admin/dashboard" class="logo-small">
            <img src="${pageContext.request.contextPath}/assets/img/logo-small.svg" alt="HRMS Logo">
        </a>
        <a href="${pageContext.request.contextPath}/admin/dashboard" class="dark-logo">
            <img src="${pageContext.request.contextPath}/assets/img/logo-white.svg" alt="HRMS Logo">
        </a>
    </div>
    <div class="sidebar-menu" id="admin-sidebar-menu">
        <ul>
            <li class="menu-title"><span>MAIN MENU</span></li>
            <li>
                <a href="${pageContext.request.contextPath}/admin/dashboard">
                    <i class="ti ti-smart-home"></i><span>Dashboard</span>
                </a>
            </li>
            <li class="submenu">
                <a href="#" class="submenu-toggle" aria-expanded="false">
                    <i class="ti ti-users"></i><span>Employees</span><span class="menu-arrow"></span>
                </a>
                <ul>
                    <li><a href="${pageContext.request.contextPath}/Employee/AddDepartment"><span>Add Department</span></a></li>
                    <li><a href="${pageContext.request.contextPath}/Employee/Role"><span>Add Role</span></a></li>
                    <li><a href="${pageContext.request.contextPath}/Employee/AddDesignation"><span>Add Designation</span></a></li>
                    <li><a href="${pageContext.request.contextPath}/Employee/EmployeeList"><span>Employee List</span></a></li>
                    <li><a href="${pageContext.request.contextPath}/Employee/EmployeeGrid"><span>Employee Grid</span></a></li>
                    <li><a href="${pageContext.request.contextPath}/Employee/EmployeeDetails"><span>Employee Details</span></a></li>
                </ul>
            </li>
            <li class="submenu">
                <a href="#" class="submenu-toggle" aria-expanded="false">
                    <i class="ti ti-calendar-check"></i><span>Attendance</span><span class="menu-arrow"></span>
                </a>
                <ul>
                    <li class="submenu">
                        <a href="#" class="submenu-toggle" aria-expanded="false"><span>Leaves</span><span class="menu-arrow"></span></a>
                        <ul>
                            <li><a href="${pageContext.request.contextPath}/leaves/apply"><span>Apply Leave</span></a></li>
                            <li><a href="${pageContext.request.contextPath}/leaves"><span>Leave Details</span></a></li>
                            <li><a href="${pageContext.request.contextPath}/leaves/approval"><span>Leave Approval</span></a></li>
                        </ul>
                    </li>
                    <li><a href="${pageContext.request.contextPath}/attendance"><span>Attendance (Admin)</span></a></li>
                    <li><a href="${pageContext.request.contextPath}/timesheet"><span>Timesheet</span></a></li>
                </ul>
            </li>
            <li class="submenu">
                <a href="#" class="submenu-toggle" aria-expanded="false">
                    <i class="ti ti-school"></i><span>Training</span><span class="menu-arrow"></span>
                </a>
                <ul>
                    <li><a href="${pageContext.request.contextPath}/trainerList"><span>Trainer List</span></a></li>
                    <li><a href="${pageContext.request.contextPath}/training-type"><span>Training Type</span></a></li>
                </ul>
            </li>
            <li class="submenu">
                <a href="#" class="submenu-toggle" aria-expanded="false">
                    <i class="ti ti-file-description"></i><span>Documents</span><span class="menu-arrow"></span>
                </a>
                <ul>
                    <li class="submenu">
                        <a href="#" class="submenu-toggle" aria-expanded="false"><span>Upload Documents</span><span class="menu-arrow"></span></a>
                        <ul>
                            <li><a href="${pageContext.request.contextPath}/uploadFile"><span>Upload Document</span></a></li>
                            <li><a href="${pageContext.request.contextPath}/documentList"><span>Document List</span></a></li>
                        </ul>
                    </li>
                    <li><a href="${pageContext.request.contextPath}/generateLetter"><span>Generate Letter</span></a></li>
                </ul>
            </li>
            <li class="submenu">
                <a href="#" class="submenu-toggle" aria-expanded="false">
                    <i class="ti ti-chart-bar"></i><span>Reports</span><span class="menu-arrow"></span>
                </a>
                <ul>
                    <li><a href="${pageContext.request.contextPath}/admin/employee-report"><span>Employee Report</span></a></li>